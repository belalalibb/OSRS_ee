{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osrs-ee.local/schemas/ai_proposal.schema.json",
  "title": "AIProposal v1.0 (advisory only; no execution authority)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","incident_id","account_id","session_epoch","observed_state_version","diagnosis","suggested_action","parameters","requires_human_approval","confidence"],
  "properties": {
    "schema_version": {"$ref": "https://osrs-ee.local/schemas/common.schema.json#/$defs/schema_version"},
    "incident_id": {"$ref": "https://osrs-ee.local/schemas/common.schema.json#/$defs/opaque_id"}, "account_id": {"$ref": "https://osrs-ee.local/schemas/common.schema.json#/$defs/opaque_id"},
    "session_epoch": {"$ref": "https://osrs-ee.local/schemas/common.schema.json#/$defs/epoch"}, "observed_state_version": {"$ref": "https://osrs-ee.local/schemas/common.schema.json#/$defs/state_version"},
    "diagnosis": {"type": "string", "minLength": 1, "maxLength": 2000},
    "suggested_action": {"$ref": "https://osrs-ee.local/schemas/common.schema.json#/$defs/ai_action"},
    "parameters": {"type": "object", "additionalProperties": false, "maxProperties": 0},
    "requires_human_approval": {"type": "boolean", "const": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
